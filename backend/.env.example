APP_NAME=PlateFlow API
APP_ENV=dev
DATABASE_URL=sqlite:///./plateflow.db
CORS_ORIGINS=http://localhost:5173

INFERENCE_TIMEOUT_SECONDS=45
VIDEO_JOB_TIMEOUT_SECONDS=600

MODEL_PATH=./model/best.pt
OUTPUT_DIR=./plateflow_outputs
ENABLE_FRAME_SKIP=false
PROCESS_EVERY_N_FRAMES=1
OCR_EVERY_N_FRAMES=5
OCR_BEST_MIN_IMPROVEMENT=0.08
OCR_MAX_SUBMISSIONS_PER_FIELD=3
DUPLICATE_FRAME_SKIP=true
DUPLICATE_FRAME_STABLE_COUNT=3
DUPLICATE_FRAME_DIFF_THRESH=1.5
CONF=0.45
TRUCK_CONF_THRESH=0.70
IOU_MERGE_THRESH=0.10
ACTIVE_WINDOW_FRAMES=90

# ── Two-truck separation (generic, no ROI/lanes) ─────────────────────────────
# 1) Position guard: two trucks in frame at the same time at different coordinates get
#    separate ids (centre differs by > TRUCK_SEP_FRAC of the frame size in x OR y).
TRUCK_SEP_FRAC=0.10
TRUCK_CONCURRENT_FRAMES=15
# 2) Appearance (ReID) split: when trucks stop at the SAME spot one-after-another (boxes
#    overlap, so position can't separate them), split by colour signature — a detection
#    kept on an id that looks different (HSV-histogram correlation < APPEARANCE_MATCH_THRESH)
#    for APPEARANCE_SPLIT_PATIENCE frames gets a fresh id. Tune on real footage: lower the
#    thresh if one truck splits into two; raise it if two trucks still share an id.
APPEARANCE_SPLIT=true
APPEARANCE_MATCH_THRESH=0.35
APPEARANCE_SPLIT_PATIENCE=5
APPEARANCE_MIN_CROP=60
TRUCK_DEDUP_IOU_THRESH=0.35
MIN_TRUCK_MASK_AREA=20000
INFER_WIDTH=1280
YOLO_TRACKER=botsort.yaml
SAVE_DETECTION_CROPS=true
SAVE_PROCESSED_FRAMES=true
MULTI_CAMERA_ORDER=front,right,back,left
MULTI_CAMERA_TIME_OFFSETS_SECONDS=front=0,right=0,back=0,left=0
MULTI_CAMERA_ORDER_FALLBACK=true
MULTI_CAMERA_ASSUME_SINGLE_ENTITY=false
MULTI_CAMERA_REVIEW_THRESHOLD=0.75

# Gate mode: assume exactly one vehicle passes the checkpoint at a time.
# All camera observations are merged into a single entity (confidence 0.95).
MULTI_CAMERA_GATE_MODE=false

# Camera role hints: authoritative fields per camera, used as tiebreaker when
# multiple cameras detect the same field at equal confidence.
# Format: camera:field1,field2;camera:field3
# Example for a 4-camera gate (front/back → plates, sides → container info):
# MULTI_CAMERA_CAMERA_ROLES=front:license_plate,truck_number,truck_company,driver;back:license_plate,truck_number;left:container_number,container_side_no,container_company_logo,other_container_info;right:container_number,container_side_no,container_company_logo,other_container_info
MULTI_CAMERA_CAMERA_ROLES=

TRACK_FRAGMENT_MERGE_GAP_SECONDS=20
TRACK_FRAGMENT_MERGE_AGGRESSIVE=true

# ── Single ROI + 2D-position truck separation (engine) ───────────────────────
# The operator draws ONE rectangular ROI per gate camera in "ROI Setup". Inside it
# a truck gets a permanent id and at most ROI_MAX_OBJECTS trucks are tracked at once;
# two trucks are kept on SEPARATE ids by their detection bbox centroid in BOTH axes.
# TRUCK_SEP_FRAC is the separation threshold as a fraction of the frame dimension
# (x uses width, y uses height): two concurrent detections closer than this in BOTH
# axes are the same truck; farther in EITHER axis are distinct. Lower it if two
# side-by-side trucks still merge; raise it if one truck is split into two.
ROI_MAX_OBJECTS=2
TRUCK_SEP_FRAC=0.10
# Two candidate trucks count as "concurrent" for the separation barrier when seen
# within this many frames of each other (older ones are handled by ROI turnover).
TRUCK_CONCURRENT_FRAMES=15
# A ROI slot is free again after its occupant has been gone this many frames; the
# next truck to take that position then gets a fresh id (queue turnover).
ROI_VACATE_FRAMES=45

# ── Dynamic multi-truck consolidation ────────────────────────────────────────
# Leave TRUCK_TIME_BOUNDARIES_SECONDS EMPTY to run the generic, geometry-driven
# gate sweep (recommended once ROIs are drawn). Set fixed changeover seconds only to
# force a known truck count on legacy recordings — it overrides the sweep.
TRUCK_TIME_BOUNDARIES_SECONDS=
# Route each timestamped back-camera read to the front truck whose exit it is nearest,
# so one continuous back track feeds truck_number/company to several trucks correctly.
MULTI_CAMERA_BACK_ATTACH_BY_TIME=true

# GPU PaddleOCR fallback: when a MinerU read fails or comes back empty, the crop
# is retried on a local PaddleOCR engine on the RTX 3060. Because paddlepaddle-gpu
# and YOLO's torch-CUDA cannot share one Windows process (same cuDNN/cuBLAS DLL
# names, WinError 127), PaddleOCR runs in a SEPARATE worker process out of its own
# venv (backend/.venv_ocr, torch is CPU-only there). The backend spawns it lazily
# on the first MinerU miss. See requirements.txt for the one-time venv setup.
# Degrades to MinerU-only automatically if the worker venv is absent.
PADDLE_OCR_FALLBACK=true
# Use local GPU PaddleOCR as the PRIMARY OCR engine (MinerU cloud as fallback), so
# reads return in ~ms and stream to the frontend during the run. Set 0 for the old
# MinerU-first order. The crop-send gate (OCR_CONF_THRESH) is unchanged at 0.75.
PADDLE_OCR_PRIMARY=true
PADDLE_OCR_DEVICE=gpu           # worker device: gpu or cpu
PADDLE_OCR_LANG=en
PADDLE_OCR_MIN_SCORE=0.5        # min recognition confidence (read by the worker)
# GPU OCR worker process knobs (defaults are fine):
OCR_GPU_WORKER_HOST=127.0.0.1
OCR_GPU_WORKER_PORT=8899
# OCR_GPU_WORKER_PYTHON=./.venv_ocr/Scripts/python.exe   # override worker interpreter
# OCR_GPU_WORKER_STARTUP_TIMEOUT=120                      # seconds to wait for model load
