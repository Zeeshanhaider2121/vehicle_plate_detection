APP_NAME=PlateFlow API
APP_ENV=dev
DATABASE_URL=sqlite:///./plateflow.db
CORS_ORIGINS=http://localhost:5173

COLAB_INFER_URL=
COLAB_INFER_PATH=/infer
COLAB_ANALYZE_VIDEO_PATH=/analyze-video
COLAB_START_VIDEO_JOB_PATH=/analyze-video/start
COLAB_VIDEO_JOB_STATUS_PATH_TEMPLATE=/analyze-video/jobs/{job_id}
COLAB_VIDEO_JOB_RESULT_PATH_TEMPLATE=/analyze-video/jobs/{job_id}/result
COLAB_VIDEO_JOB_FRAME_PATH_TEMPLATE=/analyze-video/jobs/{job_id}/frame
INFERENCE_TIMEOUT_SECONDS=45
VIDEO_JOB_TIMEOUT_SECONDS=600
MOCK_INFERENCE_IF_UNAVAILABLE=true

OUTPUT_DIR=./plateflow_outputs
ENABLE_FRAME_SKIP=false
PROCESS_EVERY_N_FRAMES=1
OCR_EVERY_N_FRAMES=5
CONF=0.45
TRUCK_CONF_THRESH=0.92
TRUCK_DEDUP_IOU_THRESH=0.35
MIN_TRUCK_MASK_AREA=20000
INFER_WIDTH=1280
YOLO_TRACKER=botsort.yaml
SAVE_DETECTION_CROPS=true
MULTI_CAMERA_ORDER=front,right,back,left
MULTI_CAMERA_TIME_OFFSETS_SECONDS=front=0,right=0,back=0,left=0
MULTI_CAMERA_ORDER_FALLBACK=true
MULTI_CAMERA_ASSUME_SINGLE_ENTITY=false
MULTI_CAMERA_REVIEW_THRESHOLD=0.75

# Gate mode: assume exactly one vehicle passes the checkpoint at a time.
# All camera observations are merged into a single entity (confidence 0.95).
MULTI_CAMERA_GATE_MODE=false

# Camera role hints: authoritative fields per camera, used as tiebreaker when
# multiple cameras detect the same field at equal confidence.
# Format: camera:field1,field2;camera:field3
# Example for a 4-camera gate (front/back → plates, sides → container info):
# MULTI_CAMERA_CAMERA_ROLES=front:license_plate,truck_number,truck_company,driver;back:license_plate,truck_number;left:container_number,container_side_no,container_company_logo,other_container_info;right:container_number,container_side_no,container_company_logo,other_container_info
MULTI_CAMERA_CAMERA_ROLES=

TRACK_FRAGMENT_MERGE_GAP_SECONDS=20
TRACK_FRAGMENT_MERGE_AGGRESSIVE=true
